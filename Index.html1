<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRINEPLAY</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#080808;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#111;
 padding:22px;
 text-align:center;
 border-bottom:2px solid #d4af37;
}
.logo{
 color:#e4bd48;
 font-size:32px;
 font-weight:bold;
 letter-spacing:3px;
}
.balance{
 background:#171717;
 margin:20px;
 padding:25px;
 border:1px solid #c9a43b;
 border-radius:15px;
 text-align:center;
}
.balance h2{color:#e4bd48}
button{
 background:linear-gradient(90deg,#b88b22,#f5d76e);
 color:#111;
 border:0;
 border-radius:10px;
 padding:13px 18px;
 font-weight:bold;
 margin:5px;
 cursor:pointer;
}
h3{color:#e4bd48}
.games{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px;
 padding:15px;
}
.game{
 background:#171717;
 border:1px solid #57451c;
 border-radius:14px;
 padding:20px 10px;
 text-align:center;
}
.game button{width:90%}
footer{
 text-align:center;
 padding:25px;
 color:#777;
}
</style>
</head>
<body>
<header>
 <div class="logo">TRINEPLAY</div>
 <p>Твоя ігрова територія</p>
</header>
<div class="balance">
 <h3>ТВІЙ БАЛАНС</h3>
 <h2 id="balance">1 000 ₴</h2>
 <button onclick="bonus()">🎁 Бонус</button>
 <button onclick="alert('Демо: поповнення недоступне')">＋ Поповнити</button>
 <button onclick="alert('Демо: виведення недоступне')">Вивести</button>
</div>
<h3 style="text-align:center">🎮 ІГРИ</h3>
<div class="games">
 <div class="game">
  🎲<h3>Кубики</h3>
  <button onclick="dice()">Грати</button>
 </div>
 <div class="game">
  🎡<h3>Колесо</h3>
  <button onclick="wheel()">Грати</button>
 </div>
 <div class="game">
  💣<h3>Мінер</h3>
  <button onclick="mines()">Грати</button>
 </div>
 <div class="game">
  🍒<h3>Слоти</h3>
  <button onclick="slots()">Грати</button>
 </div>
</div>
<footer>
 TRINEPLAY © 2026<br>
 Демоверсія • Віртуальні бали
</footer>
<script>
let money=1000;
let bonusUsed=false;
function update(){
 document.getElementById('balance').innerText=money.toLocaleString('uk-UA')+' ₴';
}
function bonus(){
 if(bonusUsed){alert('Бонус уже отримано!');return;}
 money+=100;
 bonusUsed=true;
 update();
 alert('Вітаємо! +100 віртуальних балів');
}
function play(){
 if(money<10){alert('Недостатньо балів');return false;}
 money-=10;
 update();
 return true;
}
function dice(){
 if(!play())return;
 let n=Math.floor(Math.random()*6)+1;
 if(n>=4){money+=25;alert('Випало '+n+'! Ти виграв 25 балів');}
 else alert('Випало '+n+'. Спробуй ще!');
 update();
}
function wheel(){
 if(!play())return;
 let n=Math.floor(Math.random()*5);
 let prizes=[0,10,20,30,50];
 money+=prizes[n];
 update();
 alert('Колесо принесло '+prizes[n]+' балів!');
}
function mines(){
 if(!play())return;
 let win=Math.random()>.4;
 if(win){money+=25;alert('Ти знайшов приз! +25 балів');}
 else alert('Міна! Спробуй ще.');
 update();
}
function slots(){
 if(!play())return;
 let a=['🍒','🍋','⭐','💎'];
 let x=a[Math.floor(Math.random()*4)];
 let y=a[Math.floor(Math.random()*4)];
 let z=a[Math.floor(Math.random()*4)];
 if(x===y&&y===z){money+=100;alert(x+' '+y+' '+z+' — ДЖЕКПОТ! +100');}
 else alert(x+' '+y+' '+z+' — Спробуй ще!');
 update();
}
</script>
</body>
</html>
